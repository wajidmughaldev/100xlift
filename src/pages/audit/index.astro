---

import BaseLayout from "../../layouts/BaseLayout.astro";

---

<BaseLayout
  title="100XLIFT Free Audit"
  headerVariant="promo"
  showPreloader={false}
>

<main>

            <!-- tp-contact-me-area-start -->
            <div class="tp-contact-me-area tp-pd-2-ptb pt-175 pb-100">
  <div class="container">
    <div class="row">
      <div class="col-xl-6">
        <div class="tp-contact-me-title-wrap mb-30">
          <h3
            class="tp-section-title tp-ff-sequel-semi-bold fs-72 tp_fade_anim mb-20"
            data-delay=".3"
          >
            Get a Free <br />
            Website Audit.
          </h3>

          <p class="text-white tp_fade_anim mb-25 opacity-1 d-block" data-delay=".4">
            Quick wins for speed, SEO, and conversions, tailored to your site.
          </p>

          <div class="tp-pd-2-categories tp_fade_anim" data-delay=".5">
            <span><a href="/portfolio">Website</a></span>
            <span>Free Audit</span>
          </div>
        </div>
      </div>

      <div class="col-xl-6">
        <div class="tp-contact-me-form mb-30">
          <form
            id="free-audit-form"
            action="https://formsubmit.co/100xlift@gmail.com"
            data-ajax-action="https://formsubmit.co/ajax/100xlift@gmail.com"
            method="POST"
          >
            <input type="hidden" name="_subject" value="100xLift Free Audit Request">
            <input type="hidden" name="_template" value="table">
            <input type="hidden" name="_form_start" value="">
            <input type="text" name="_honey" tabindex="-1" autocomplete="off" style="display:none">
            <h4 class="tp-contact-me-title tp-ff-sequel-semi-bold mb-25">
              Request your Free Audit...
            </h4>

            <input class="tp-input mb-15" name="name" type="text" placeholder="Full Name" required>
            <input class="tp-input mb-15" name="email" type="email" placeholder="Email Address" required>
            <input class="tp-input mb-15" name="phone" type="text" placeholder="WhatsApp Number (optional)">
            <input class="tp-input mb-45" name="website" type="url" placeholder="Website URL" required>

            <h4 class="tp-contact-me-title tp-ff-sequel-semi-bold mb-25">
              Audit Focus
            </h4>

            <div class="tp-contact-me-category mb-45 mr-180">
              <label for="audit1">
                <input id="audit1" type="checkbox" name="audit_focus[]" value="Speed & Core Web Vitals">
                <span>Speed & Core Web Vitals</span>
              </label>

              <label for="audit2">
                <input id="audit2" type="checkbox" name="audit_focus[]" value="SEO & Rankings">
                <span>SEO & Rankings</span>
              </label>

              <label for="audit3">
                <input id="audit3" type="checkbox" name="audit_focus[]" value="Conversion & UX">
                <span>Conversion & UX</span>
              </label>

              <label for="audit4">
                <input id="audit4" type="checkbox" name="audit_focus[]" value="Messaging & Content">
                <span>Messaging & Content</span>
              </label>

              <label for="audit5">
                <input id="audit5" type="checkbox" name="audit_focus[]" value="Technical Health">
                <span>Technical Health</span>
              </label>

              <label for="audit6">
                <input id="audit6" type="checkbox" name="audit_focus[]" value="Tracking & Analytics">
                <span>Tracking & Analytics</span>
              </label>
            </div>

            <input class="tp-input mb-15" name="industry" type="text" placeholder="Industry (e.g., Real Estate, Clinic, E-commerce)">
            <input class="tp-input mb-15" name="goal" type="text" placeholder="Main goal (e.g., more leads, more sales, better rankings)">
            <textarea class="tp-input tp-textarea mb-30" name="message" placeholder="Anything specific you want us to check? (optional)"></textarea>

            <button type="submit" class="tp-btn tp-btn-red tp-btn-xl tp-ff-inter d-inline-block">
              <span>
                <span class="text-1">Request Free Audit</span>
                <span class="text-2">Request Free Audit</span>
              </span>
              <i>
                <svg width="11" height="11" viewBox="0 0 11 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M0.21967 9.40717C-0.0732232 9.70006 -0.0732232 10.1749 0.21967 10.4678C0.512563 10.7607 0.987437 10.7607 1.28033 10.4678L0.21967 9.40717ZM10.6875 0.75C10.6875 0.335786 10.3517 2.97145e-09 9.9375 1.50485e-07L3.1875 -2.70983e-07C2.77329 -2.70983e-07 2.4375 0.335786 2.4375 0.75C2.4375 1.16421 2.77329 1.5 3.1875 1.5H9.1875V7.5C9.1875 7.91421 9.52329 8.25 9.9375 8.25C10.3517 8.25 10.6875 7.91421 10.6875 7.5L10.6875 0.75ZM0.75 9.9375L1.28033 10.4678L10.4678 1.28033L9.9375 0.75L9.40717 0.21967L0.21967 9.40717L0.75 9.9375Z" fill="currentColor" />
                </svg>
                <svg width="11" height="11" viewBox="0 0 11 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M0.21967 9.40717C-0.0732232 9.70006 -0.0732232 10.1749 0.21967 10.4678C0.512563 10.7607 0.987437 10.7607 1.28033 10.4678L0.21967 9.40717ZM10.6875 0.75C10.6875 0.335786 10.3517 2.97145e-09 9.9375 1.50485e-07L3.1875 -2.70983e-07C2.77329 -2.70983e-07 2.4375 0.335786 2.4375 0.75C2.4375 1.16421 2.77329 1.5 3.1875 1.5H9.1875V7.5C9.1875 7.91421 9.52329 8.25 9.9375 8.25C10.3517 8.25 10.6875 7.91421 10.6875 7.5L10.6875 0.75ZM0.75 9.9375L1.28033 10.4678L10.4678 1.28033L9.9375 0.75L9.40717 0.21967L0.21967 9.40717L0.75 9.9375Z" fill="currentColor" />
                </svg>
              </i>
            </button>

            <p class="ajax-response mt-20"></p>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

            <!-- tp-contact-me-area-end -->

         </main>

<script is:inline slot="body-end">
  (() => {
    const form = document.getElementById("free-audit-form");
    if (!form) return;

    const responseEl = form.querySelector(".ajax-response");
    const submitBtn = form.querySelector('button[type="submit"]');
    const startField = form.querySelector('input[name="_form_start"]');

    if (startField) {
      startField.value = Date.now().toString();
    }

    let isSubmitting = false;

    const setStatus = (message, ok) => {
      if (!responseEl) return;
      responseEl.textContent = message;
      responseEl.classList.toggle("text-success", ok);
      responseEl.classList.toggle("text-danger", !ok);
    };

    form.addEventListener("submit", async (event) => {
      if (isSubmitting) {
        event.preventDefault();
        return;
      }

      const honey = form.querySelector('input[name="_honey"]');
      if (honey && honey.value) {
        event.preventDefault();
        return;
      }

      const startedAt = parseInt(startField?.value || "0", 10);
      if (startedAt && Date.now() - startedAt < 3000) {
        event.preventDefault();
        setStatus("Please wait a moment and try again.", false);
        return;
      }

      isSubmitting = true;
      submitBtn?.setAttribute("disabled", "disabled");
      submitBtn?.setAttribute("aria-busy", "true");
      setStatus("Sending...", true);
      event.preventDefault();

      try {
        const formData = new FormData(form);
        const ajaxAction = form.getAttribute("data-ajax-action");
        const response = await fetch(ajaxAction, {
          method: "POST",
          body: formData,
          headers: { Accept: "application/json" },
        });

        if (response.ok) {
          setStatus("Thanks! Your request has been sent.", true);
          form.reset();
          if (startField) {
            startField.value = Date.now().toString();
          }
        } else {
          setStatus("Something went wrong. Please try again.", false);
        }
      } catch (error) {
        setStatus("Network error. Please try again.", false);
      } finally {
        isSubmitting = false;
        submitBtn?.removeAttribute("disabled");
        submitBtn?.removeAttribute("aria-busy");
      }
    });
  })();
</script>

</BaseLayout>
