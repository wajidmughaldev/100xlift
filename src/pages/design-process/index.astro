  <script>
    const steps = {
      1: {
        step: "Step 01",
        title: "Exploration Phase",
        desc: "We listen, analyse and draw conclusions to recommend the most relevant solutions. Through workshops, interviews and research we get to know the brand from the inside. This stage allows us to uncover key insights and gather essential information for the next phases of the project.",
        badge: "Key Activities",
        leftTitle: "What we do",
        leftItems: [
          "Research & Analysis",
          "Brand Audit",
          "Identifying Problems and Needs",
          "Defining Project Goals",
          "Discovery Workshops"
        ],
        rightTitle: "What it unlocks",
        rightItems: [
          "Shared clarity on the real problem",
          "Aligned goals and constraints",
          "Better decisions in strategy and design",
          "Less rework later"
        ]
      },
      2: {
        step: "Step 02",
        title: "Strategic Phase",
        desc: "Based on collected data and insights, we develop a concept that defines the brand's identity, positioning and communication approach. The outcome is a clear strategy that reflects the brand's context, goals and ambition, delivered as a document with guidelines for design, marketing and communication.",
        badge: "Key Activities",
        leftTitle: "What we define",
        leftItems: [
          "Defining Brand Personality",
          "Brand Positioning",
          "Defining Unique Value Proposition",
          "Establishing Tone of Voice",
          "Selecting Communication Channels",
          "Brand Architecture",
          "Moodboards",
          "Communication Strategy"
        ],
        rightTitle: "What you receive",
        rightItems: [
          "Strategy document with clear direction",
          "Messaging and tone guidance",
          "Positioning you can defend",
          "A decision framework for design"
        ]
      },
      3: {
        step: "Step 03",
        title: "Design Phase",
        desc: "We create the key assets and tools that support effective communication with the brand's audience. Everything is adapted to a range of media, from print materials and websites to social platforms. All of it is designed to build a cohesive and recognisable brand identity.",
        badge: "Key Activities",
        leftTitle: "What we design",
        leftItems: [
          "Defining the Core Visual Direction",
          "Designing the Logo and its System",
          "Developing the Brand's Visual Language",
          "Creating Supporting Graphic Elements",
          "Copywriting",
          "Establishing the Brand's Communication Style",
          "Designing Printed and Digital Brand Assets"
        ],
        rightTitle: "What stays consistent",
        rightItems: [
          "A visual system your team can scale",
          "Assets that work across channels",
          "Cohesive look and feel everywhere",
          "Clear rules, flexible execution"
        ]
      },
      4: {
        step: "Step 04",
        title: "Delivery Phase",
        desc: "We finalise and deliver all key materials and make sure the designed elements are applied correctly. We also support brand activation, internal launch and team training to ensure smooth use of the new assets. This allows the brand to make full use of its new identity.",
        badge: "Key Activities",
        leftTitle: "What we deliver",
        leftItems: [
          "Brand Manual",
          "Brand Implementation Supervision",
          "Brand Launch",
          "Team Training",
          "Post-Launch Support"
        ],
        rightTitle: "How it lands",
        rightItems: [
          "Clean rollout with oversight",
          "Team adoption, not confusion",
          "Consistency from day one",
          "Support after launch"
        ]
      }
    };

    const panel = document.getElementById("panel");
    const navBtns = Array.from(document.querySelectorAll(".side-btn"));

    function renderStep(n){
      const s = steps[n];
      panel.innerHTML = `
        <div class="panel-kicker">
          <div class="left">
            <div class="panel-step">${s.step}</div>
            <div style="width:6px;height:6px;border-radius:999px;background:rgba(255,255,255,.20)"></div>
            <div style="color:rgba(255,255,255,.72); font-size:13px; letter-spacing:.12em; text-transform:uppercase;">Process</div>
          </div>
          <div class="badge">${s.badge}</div>
        </div>

        <div class="panel-title">${s.title}</div>
        <p class="panel-desc">${s.desc}</p>

        <div class="key-acts">
          <div class="acts-card">
            <div class="acts-head">
              <b>${s.leftTitle}</b>
              <span class="badge">Primary</span>
            </div>
            <ul class="list">
              ${s.leftItems.map((x,i)=>`<li class="li"><i>${String(i+1).padStart(2,"0")}</i><span>${x}</span></li>`).join("")}
            </ul>
          </div>

          <div class="acts-card">
            <div class="acts-head">
              <b>${s.rightTitle}</b>
              <span class="badge">Outcome</span>
            </div>
            <ul class="list">
              ${s.rightItems.map((x,i)=>`<li class="li"><i>${String(i+1).padStart(2,"0")}</i><span>${x}</span></li>`).join("")}
            </ul>

            <div style="margin-top:14px; padding:14px; border-radius:18px; border:1px solid rgba(185,253,80,.22); background: rgba(185,253,80,.06); color:rgba(255,255,255,.82); line-height:1.55; font-size:14px;">
              <b style="color:rgba(255,255,255,.92)">Note:</b>
              Each phase is designed to reduce uncertainty. The goal is fewer opinions, more proof.
            </div>
          </div>
        </div>
      `;
    }

    navBtns.forEach(btn=>{
      btn.addEventListener("click", ()=>{
        navBtns.forEach(b=>b.setAttribute("aria-current","false"));
        btn.setAttribute("aria-current","true");
        renderStep(btn.dataset.step);
      });
    });

    renderStep(1);

    // FAQ accordion
    const qa = Array.from(document.querySelectorAll(".qa"));
    qa.forEach(row=>{
      const q = row.querySelector(".q");
      q.addEventListener("click", ()=>{
        const open = row.classList.contains("open");
        qa.forEach(r=>r.classList.remove("open"));
        if(!open) row.classList.add("open");
      });
    });
  </script>
  </main>
