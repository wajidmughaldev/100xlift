---
import BaseLayout from "../../layouts/BaseLayout.astro";

const siteUrl = "https://www.100xlift.com";
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const pageTitle = "100xLift - Design Process";
const pageDescription = "See how 100xLift plans, designs, and delivers high-performing websites and digital experiences.";
const pageKeywords = "design process, web design workflow, UX process, 100xlift";
const ogImage = "/assets/img/logo/logo-white.png";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  robots="index,follow"
  ogImage={ogImage}
  ogType="website"
  locale="en_US"
  siteName="100xLift"
  twitterSite=""
  twitterCreator=""
  themeColor="#0b0f1a"
  keywords={pageKeywords}
  author="100xLift"
  publishedTime=""
  modifiedTime=""
  structuredData={null}
  lang="en"
  htmlClass="no-js cunnet-dark"
  bodyClass="tp-magic-cursor"
  ogTitle={pageTitle}
  ogDescription={pageDescription}
  ogUrl={canonical}
  twitterTitle={pageTitle}
  twitterDescription={pageDescription}
  headerVariant="simple"
  showPreloader={true}
>
  <style slot="head">
    :root{
      --bg:#0E0F11;
      --accent:#B9FD50;
      --text:rgba(255,255,255,.92);
      --muted:rgba(255,255,255,.62);
      --dim:rgba(255,255,255,.10);
      --card:rgba(255,255,255,.04);
      --card2:rgba(255,255,255,.06);
      --border:rgba(255,255,255,.10);
      --shadow: 0 24px 70px rgba(0,0,0,.55);
      --r-lg:28px;
      --r-md:18px;
      --r-sm:12px;
      --max:1180px;
    }

    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0;
      background:var(--bg);
      color:var(--text);
      font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji","Segoe UI Emoji";
      letter-spacing:-0.02em;
      overflow-x:hidden;
    }

    a{color:inherit;text-decoration:none}
    .wrap{max-width:var(--max); margin:0 auto; padding:0 20px}
    .section{padding:92px 0}
    .eyebrow{
      display:inline-flex; align-items:center; gap:10px;
      font-size:12px; letter-spacing:.14em; text-transform:uppercase;
      color:var(--muted);
    }
    .dot{width:8px;height:8px;border-radius:999px;background:var(--accent); box-shadow:0 0 22px rgba(185,253,80,.55)}
    .h1{
      font-size: clamp(40px, 5vw, 68px);
      line-height:1.02;
      margin:14px 0 16px;
    }
    .lead{
      font-size: clamp(16px, 1.7vw, 19px);
      line-height:1.55;
      color:var(--muted);
      max-width: 62ch;
      margin:0;
    }

    /* Top bar */
    .topbar{
      position:sticky; top:0; z-index:50;
      backdrop-filter: blur(14px);
      background: linear-gradient(to bottom, rgba(14,15,17,.78), rgba(14,15,17,.35));
      border-bottom:1px solid rgba(255,255,255,.06);
    }
    .topbar-inner{
      display:flex; align-items:center; justify-content:space-between;
      padding:16px 0;
    }
    .brand{
      display:flex; align-items:center; gap:10px;
      font-weight:700; letter-spacing:-.03em;
    }
    .brand-mark{
      width:34px; height:34px; border-radius:12px;
      background:
        radial-gradient(60% 60% at 30% 30%, rgba(185,253,80,.95), rgba(185,253,80,.25) 55%, rgba(185,253,80,0) 75%),
        linear-gradient(135deg, rgba(255,255,255,.10), rgba(255,255,255,0));
      border:1px solid rgba(185,253,80,.35);
      box-shadow:0 12px 30px rgba(185,253,80,.10);
    }
    .nav{
      display:flex; gap:10px; align-items:center;
    }
    .pill{
      display:inline-flex; align-items:center; gap:8px;
      padding:10px 12px;
      border-radius:999px;
      background:rgba(255,255,255,.04);
      border:1px solid rgba(255,255,255,.08);
      color:rgba(255,255,255,.78);
      font-size:13px;
    }
    .pill:hover{border-color:rgba(185,253,80,.28); color:rgba(255,255,255,.90)}
    .cta{
      padding:10px 14px;
      border-radius:999px;
      background:rgba(185,253,80,.10);
      border:1px solid rgba(185,253,80,.35);
      color:rgba(255,255,255,.92);
      font-size:13px;
      box-shadow:0 18px 40px rgba(185,253,80,.06);
    }
    .cta:hover{background:rgba(185,253,80,.14)}

    /* Hero */
    .hero{
      position:relative;
      padding:74px 0 54px;
      overflow:hidden;
    }
    .hero-grid{
      display:grid;
      grid-template-columns: 1.1fr .9fr;
      gap:38px;
      align-items:center;
    }

    /* Neon blob like the reference */
    .blob{
      position:absolute;
      right:-220px;
      top:-260px;
      width:720px;
      height:720px;
      border-radius: 46% 54% 58% 42% / 46% 44% 56% 54%;
      background:
        radial-gradient(closest-side at 35% 35%, rgba(185,253,80,.95), rgba(185,253,80,.35) 55%, rgba(185,253,80,0) 72%),
        radial-gradient(closest-side at 70% 70%, rgba(185,253,80,.65), rgba(185,253,80,.18) 52%, rgba(185,253,80,0) 75%);
      filter: blur(.3px);
      opacity:.9;
      transform: rotate(18deg);
      pointer-events:none;
    }
    .blob:after{
      content:"";
      position:absolute;
      inset:88px;
      border-radius: 48% 52% 42% 58% / 52% 46% 54% 48%;
      background: radial-gradient(closest-side at 55% 45%, rgba(14,15,17,1), rgba(14,15,17,.75) 55%, rgba(14,15,17,0) 78%);
      border:1px solid rgba(255,255,255,.06);
      box-shadow: inset 0 0 0 1px rgba(185,253,80,.08);
    }
    .hero-card{
      background: linear-gradient(180deg, rgba(255,255,255,.05), rgba(255,255,255,.03));
      border:1px solid rgba(255,255,255,.09);
      border-radius: var(--r-lg);
      padding:22px;
      box-shadow: var(--shadow);
      position:relative;
      overflow:hidden;
    }
    .hero-card:before{
      content:"";
      position:absolute; inset:-1px;
      background:
        radial-gradient(600px 180px at 30% -10%, rgba(185,253,80,.16), transparent 55%),
        radial-gradient(520px 220px at 110% 30%, rgba(185,253,80,.10), transparent 58%);
      pointer-events:none;
    }
    .hero-meta{
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap:14px;
      margin-top:14px;
      position:relative;
      z-index:1;
    }
    .meta-box{
      padding:14px 14px;
      border-radius: 16px;
      background: rgba(255,255,255,.035);
      border:1px solid rgba(255,255,255,.08);
    }
    .meta-k{font-size:12px;color:var(--muted); letter-spacing:.08em; text-transform:uppercase}
    .meta-v{margin-top:6px; font-size:14px; color:rgba(255,255,255,.86); line-height:1.35}

    .hero-actions{
      display:flex; gap:12px; align-items:center;
      margin-top:22px;
    }
    .btn{
      display:inline-flex; align-items:center; justify-content:center;
      gap:10px;
      padding:12px 16px;
      border-radius:999px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(255,255,255,.05);
      color:rgba(255,255,255,.90);
      font-size:14px;
    }
    .btn:hover{border-color:rgba(185,253,80,.35)}
    .btn.primary{
      background: rgba(185,253,80,.12);
      border-color: rgba(185,253,80,.38);
    }
    .btn .arrow{
      width:9px;height:9px; border-right:2px solid rgba(255,255,255,.85); border-top:2px solid rgba(255,255,255,.85);
      transform: rotate(45deg);
    }

    /* Ticker */
    .ticker{
      border-top:1px solid rgba(255,255,255,.06);
      border-bottom:1px solid rgba(255,255,255,.06);
      background: rgba(255,255,255,.02);
      overflow:hidden;
    }
    .ticker-row{
      display:flex; gap:28px;
      padding:14px 0;
      white-space:nowrap;
      color:rgba(255,255,255,.60);
      font-size:12px;
      letter-spacing:.18em;
      text-transform:uppercase;
      animation: scroll 26s linear infinite;
    }
    @keyframes scroll{
      from{ transform: translateX(0) }
      to{ transform: translateX(-50%) }
    }

    /* Process overview */
    .grid-steps{
      display:grid;
      grid-template-columns: repeat(4, 1fr);
      gap:14px;
      margin-top:26px;
    }
    .step-card{
      border-radius: 22px;
      border:1px solid rgba(255,255,255,.09);
      background: rgba(255,255,255,.03);
      padding:18px 16px 16px;
      position:relative;
      overflow:hidden;
      min-height:122px;
    }
    .step-card:before{
      content:"";
      position:absolute; inset:-1px;
      background: radial-gradient(420px 160px at 20% 0%, rgba(185,253,80,.10), transparent 55%);
      opacity:.9;
      pointer-events:none;
    }
    .step-no{
      font-size:12px;
      letter-spacing:.14em;
      text-transform:uppercase;
      color:rgba(255,255,255,.55);
      display:flex;
      align-items:center;
      gap:10px;
      position:relative;
      z-index:1;
    }
    .step-title{
      margin-top:10px;
      font-size:18px;
      letter-spacing:-.03em;
      position:relative;
      z-index:1;
    }
    .step-tags{
      margin-top:10px;
      display:flex; flex-wrap:wrap; gap:8px;
      position:relative;
      z-index:1;
    }
    .tag{
      font-size:12px;
      padding:7px 10px;
      border-radius:999px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(255,255,255,.03);
      color:rgba(255,255,255,.72);
    }
    .tag.accent{
      border-color: rgba(185,253,80,.34);
      background: rgba(185,253,80,.08);
      color:rgba(255,255,255,.86);
    }

    /* Deep dive layout */
    .deep{
      display:grid;
      grid-template-columns: 340px 1fr;
      gap:18px;
      margin-top:32px;
      align-items:start;
    }
    .side{
      position:sticky; top:94px;
      border-radius: var(--r-lg);
      border:1px solid rgba(255,255,255,.09);
      background: rgba(255,255,255,.03);
      overflow:hidden;
    }
    .side-head{
      padding:18px 18px 14px;
      border-bottom:1px solid rgba(255,255,255,.06);
      background: rgba(255,255,255,.02);
    }
    .side-head .t{font-size:14px;color:rgba(255,255,255,.86); letter-spacing:-.02em}
    .side-head .s{margin-top:6px;font-size:13px;color:var(--muted); line-height:1.5}
    .side-nav{padding:10px}
    .side-btn{
      width:100%;
      text-align:left;
      display:flex; justify-content:space-between; align-items:center;
      gap:12px;
      padding:12px 12px;
      border-radius: 16px;
      border:1px solid transparent;
      background: transparent;
      color:rgba(255,255,255,.82);
      cursor:pointer;
      font-size:14px;
    }
    .side-btn:hover{background: rgba(255,255,255,.03); border-color: rgba(255,255,255,.06)}
    .side-btn[aria-current="true"]{
      background: rgba(185,253,80,.08);
      border-color: rgba(185,253,80,.32);
      color:rgba(255,255,255,.92);
    }
    .side-btn small{
      color:rgba(255,255,255,.55);
      letter-spacing:.12em;
      text-transform:uppercase;
      font-size:11px;
    }
    .chev{
      width:10px;height:10px;
      border-right:2px solid rgba(255,255,255,.7);
      border-bottom:2px solid rgba(255,255,255,.7);
      transform: rotate(-45deg);
      opacity:.75;
    }
    .side-btn[aria-current="true"] .chev{
      border-color: rgba(185,253,80,.95);
      opacity:1;
    }

    .panel{
      border-radius: var(--r-lg);
      border:1px solid rgba(255,255,255,.09);
      background: linear-gradient(180deg, rgba(255,255,255,.045), rgba(255,255,255,.02));
      padding:22px;
      box-shadow: 0 24px 70px rgba(0,0,0,.40);
      position:relative;
      overflow:hidden;
      min-height: 420px;
    }
    .panel:before{
      content:"";
      position:absolute; inset:-1px;
      background:
        radial-gradient(520px 220px at 0% 0%, rgba(185,253,80,.10), transparent 55%),
        radial-gradient(520px 220px at 110% 30%, rgba(185,253,80,.06), transparent 58%);
      pointer-events:none;
    }
    .panel-inner{position:relative; z-index:1}
    .panel-kicker{
      display:flex; align-items:baseline; justify-content:space-between;
      gap:16px;
      flex-wrap:wrap;
      margin-bottom:10px;
    }
    .panel-kicker .left{
      display:flex; gap:12px; align-items:baseline; flex-wrap:wrap;
    }
    .panel-step{
      font-size:12px;
      letter-spacing:.14em;
      text-transform:uppercase;
      color:rgba(255,255,255,.60);
    }
    .panel-title{
      font-size:28px;
      letter-spacing:-.04em;
      margin:6px 0 10px;
    }
    .panel-desc{
      color:var(--muted);
      font-size:15px;
      line-height:1.6;
      max-width: 80ch;
      margin:0 0 18px;
    }

    .key-acts{
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap:14px;
      margin-top:14px;
    }
    .acts-card{
      border-radius: 22px;
      background: rgba(255,255,255,.03);
      border:1px solid rgba(255,255,255,.08);
      padding:16px;
    }
    .acts-head{
      display:flex; align-items:center; justify-content:space-between;
      gap:10px;
      margin-bottom:12px;
    }
    .acts-head b{font-size:14px; letter-spacing:-.02em}
    .badge{
      font-size:11px;
      letter-spacing:.14em;
      text-transform:uppercase;
      color:rgba(255,255,255,.70);
      border:1px solid rgba(255,255,255,.10);
      background: rgba(255,255,255,.02);
      padding:7px 10px;
      border-radius:999px;
    }
    .list{
      display:grid;
      gap:10px;
      margin:0;
      padding:0;
      list-style:none;
    }
    .li{
      display:flex; align-items:flex-start; gap:10px;
      color:rgba(255,255,255,.78);
      font-size:14px;
      line-height:1.45;
    }
    .li i{
      width:22px; height:22px;
      border-radius: 8px;
      border:1px solid rgba(185,253,80,.28);
      background: rgba(185,253,80,.08);
      box-shadow: 0 12px 22px rgba(185,253,80,.06);
      display:inline-flex; align-items:center; justify-content:center;
      color:rgba(255,255,255,.88);
      font-style:normal;
      font-size:12px;
      flex:0 0 auto;
      margin-top:1px;
    }

    /* Principles */
    .split-head{
      display:flex; align-items:flex-end; justify-content:space-between;
      gap:22px;
      flex-wrap:wrap;
      margin-bottom:22px;
    }
    .h2{
      font-size: clamp(28px, 3.3vw, 44px);
      margin:10px 0 0;
      letter-spacing:-.04em;
      line-height:1.05;
    }
    .sub{
      color:var(--muted);
      max-width: 62ch;
      line-height:1.55;
      margin: 0;
      font-size:15px;
    }
    .principles{
      display:grid;
      grid-template-columns: repeat(3, 1fr);
      gap:14px;
      margin-top:18px;
    }
    .principle{
      border-radius: var(--r-lg);
      border:1px solid rgba(255,255,255,.09);
      background: rgba(255,255,255,.03);
      padding:18px;
      position:relative;
      overflow:hidden;
      min-height: 170px;
    }
    .principle:before{
      content:"";
      position:absolute; inset:-1px;
      background: radial-gradient(520px 200px at 0% 0%, rgba(185,253,80,.10), transparent 60%);
      pointer-events:none;
    }
    .principle .top{
      display:flex; justify-content:space-between; align-items:center;
      position:relative; z-index:1;
    }
    .principle .k{
      font-size:12px;
      letter-spacing:.14em;
      text-transform:uppercase;
      color:rgba(255,255,255,.60);
    }
    .plus{
      width:34px;height:34px;border-radius: 12px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(255,255,255,.03);
      display:flex;align-items:center;justify-content:center;
      color:rgba(255,255,255,.86);
      font-size:18px;
    }
    .principle h3{
      margin:14px 0 10px;
      font-size:20px;
      letter-spacing:-.03em;
      position:relative; z-index:1;
    }
    .principle p{
      margin:0;
      color:var(--muted);
      line-height:1.6;
      font-size:14.5px;
      position:relative; z-index:1;
    }

    /* Heroes / quotes */
    .quotes{
      display:grid;
      grid-template-columns: 1.05fr .95fr;
      gap:14px;
      margin-top:18px;
      align-items:start;
    }
    .quote-card{
      border-radius: var(--r-lg);
      border:1px solid rgba(255,255,255,.09);
      background: rgba(255,255,255,.03);
      padding:18px;
      position:relative;
      overflow:hidden;
    }
    .quote-card:before{
      content:"";
      position:absolute; inset:-1px;
      background: radial-gradient(520px 200px at 30% 0%, rgba(185,253,80,.08), transparent 60%);
      pointer-events:none;
    }
    .quote{
      font-size:15px;
      line-height:1.65;
      color:rgba(255,255,255,.86);
      margin:0;
      position:relative; z-index:1;
    }
    .who{
      margin-top:14px;
      display:flex; align-items:center; justify-content:space-between;
      gap:12px;
      color:rgba(255,255,255,.70);
      font-size:13px;
      position:relative; z-index:1;
    }
    .who b{color:rgba(255,255,255,.92); font-weight:650}
    .who span{
      padding:7px 10px;
      border-radius:999px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(255,255,255,.02);
      letter-spacing:.12em;
      text-transform:uppercase;
      font-size:11px;
      color:rgba(255,255,255,.66);
    }

    /* FAQ */
    .faq{
      margin-top:18px;
      border-radius: var(--r-lg);
      border:1px solid rgba(255,255,255,.09);
      background: rgba(255,255,255,.03);
      overflow:hidden;
    }
    .q{
      width:100%;
      text-align:left;
      padding:18px 18px;
      background: transparent;
      border:0;
      color:rgba(255,255,255,.90);
      display:flex; align-items:center; justify-content:space-between;
      gap:14px;
      cursor:pointer;
      font-size:15px;
      border-top:1px solid rgba(255,255,255,.06);
    }
    .q:first-child{border-top:0}
    .q:hover{background: rgba(255,255,255,.02)}
    .q .plus2{
      width:34px;height:34px;border-radius: 12px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(255,255,255,.03);
      display:flex; align-items:center; justify-content:center;
      font-size:18px;
      color:rgba(255,255,255,.82);
      flex:0 0 auto;
    }
    .a{
      padding:0 18px 18px;
      color:var(--muted);
      line-height:1.65;
      font-size:14.5px;
      display:none;
      border-top:1px solid rgba(255,255,255,.06);
    }
    .qa.open .a{display:block}
    .qa.open .q .plus2{color: rgba(185,253,80,.95); border-color: rgba(185,253,80,.28); background: rgba(185,253,80,.08)}
    .qa.open .q{background: rgba(185,253,80,.05)}

    /* Footer note */
    .foot{
      padding:36px 0 60px;
      border-top:1px solid rgba(255,255,255,.06);
      color:rgba(255,255,255,.55);
      font-size:13px;
    }

    /* Responsive */
    @media (max-width: 980px){
      .hero-grid{grid-template-columns: 1fr; gap:18px}
      .deep{grid-template-columns: 1fr}
      .side{position:relative; top:auto}
      .grid-steps{grid-template-columns: 1fr 1fr}
      .principles{grid-template-columns: 1fr}
      .quotes{grid-template-columns: 1fr}
      .key-acts{grid-template-columns: 1fr}
    }
    @media (max-width: 520px){
      .nav{display:none}
      .grid-steps{grid-template-columns: 1fr}
    }

    /* Reduced motion */
    @media (prefers-reduced-motion: reduce){
      .ticker-row{animation:none}
    }
  </style>
  <main>
  <!-- Topbar -->
  <header class="topbar">
    <div class="wrap">
      <div class="topbar-inner">
        <a class="brand" href="#">
          <span class="brand-mark" aria-hidden="true"></span>
          <span>Studio</span>
        </a>

        <nav class="nav" aria-label="Primary">
          <a class="pill" href="#process">Process</a>
          <a class="pill" href="#principles">Principles</a>
          <a class="pill" href="#heroes">Heroes</a>
          <a class="pill" href="#faq">FAQ</a>
          <a class="cta" href="#process">Start a project</a>
        </nav>

        <a class="cta" href="#process">Start a project</a>
      </div>
    </div>
  </header>

  <!-- Hero -->
  <div>
    <section class="hero">
      <div class="blob" aria-hidden="true"></div>

      <div class="wrap">
        <div class="hero-grid">
          <div>
            <div class="eyebrow"><span class="dot"></span> Our process</div>
            <h1 class="h1">Coherence from research to delivery.</h1>
            <p class="lead">
              Every step from research to delivery is built to keep your brand coherent, effective and ready for the future.
              We listen, analyse and draw conclusions to recommend the most relevant solutions. Through workshops, interviews and research
              we get to know the brand from the inside.
            </p>

            <div class="hero-actions">
              <a class="btn primary" href="#process"><span>Explore the steps</span><span class="arrow" aria-hidden="true"></span></a>
              <a class="btn" href="#faq"><span>Read the FAQ</span><span class="arrow" aria-hidden="true"></span></a>
            </div>
          </div>

          <div class="hero-card">
            <div class="eyebrow" style="position:relative;z-index:1;"><span class="dot"></span> What you get</div>
