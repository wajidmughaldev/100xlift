---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const items = await getCollection("portfolio");
  return items.map((item) => ({
    params: { slug: item.slug },
    props: { project: item },
  }));
}

const { project } = Astro.props;
const d = project.data;
const slug = project.slug;

// Related: pick 2 other projects
const all = await getCollection("portfolio");
const related = all.filter((x) => x.slug !== slug).slice(0, 2);
---

<BaseLayout title={`100XLIFT - ${d.title}`} headerVariant="promo" >
  <main>

    <!-- portfolio details 2 area start -->
    <div class="tp-pd-2-ptb tp-pd-3-style pt-175 pb-55">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="tp-pd-2-top pb-45 jump-anim text-center">
              <h3 class="tp-pd-3-title tp-ff-sequel-bold-head text-uppercase lh-1 tp_fade_anim" data-delay=".5">
                {d.title}
              </h3>
            </div>
          </div>

          <div class="col-xl-10">
            <div class="row">
              <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="tp-pd-2-bottom-item mb-20">
                  <span>{d.roleLabel}</span>
                  <h6>{d.roleValue}</h6>
                </div>
              </div>

              <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="tp-pd-2-bottom-item mb-20">
                  <span>{d.servicesLabel}</span>
                  <h6>{d.servicesValue}</h6>
                </div>
              </div>

              <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="tp-pd-2-bottom-item mb-20">
                  <span>{d.dateLabel}</span>
                  <h6>{d.dateValue}</h6>
                </div>
              </div>

              <div class="col-lg-3 col-md-6 col-sm-6">
                <div class="tp-pd-2-bottom-item mb-20">
                  <span>{d.designerLabel}</span>
                  <h6>{d.designerValue}</h6>
                </div>
              </div>
            </div>
          </div>

          <div class="col-xl-2">
            <div class="text-xl-end">
              <a class="tp-btn tp-btn-border" href={d.visitUrl} target="_blank" rel="noopener">
                <span>
                  <span class="text-1">{d.visitLabel}</span>
                  <span class="text-2">{d.visitLabel}</span>
                </span>
                <i>
                  <!-- keep your SVGs unchanged -->
                  <svg width="11" height="11" viewBox="0 0 11 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M0.21967 9.40717C-0.0732232 9.70006 -0.0732232 10.1749 0.21967 10.4678C0.512563 10.7607 0.987437 10.7607 1.28033 10.4678L0.21967 9.40717ZM10.6875 0.75C10.6875 0.335786 10.3517 2.97145e-09 9.9375 1.50485e-07L3.1875 -2.70983e-07C2.77329 -2.70983e-07 2.4375 0.335786 2.4375 0.75C2.4375 1.16421 2.77329 1.5 3.1875 1.5H9.1875V7.5C9.1875 7.91421 9.52329 8.25 9.9375 8.25C10.3517 8.25 10.6875 7.91421 10.6875 7.5L10.6875 0.75ZM0.75 9.9375L1.28033 10.4678L10.4678 1.28033L9.9375 0.75L9.40717 0.21967L0.21967 9.40717L0.75 9.9375Z" fill="currentColor" />
                  </svg>
                  <svg width="11" height="11" viewBox="0 0 11 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M0.21967 9.40717C-0.0732232 9.70006 -0.0732232 10.1749 0.21967 10.4678C0.512563 10.7607 0.987437 10.7607 1.28033 10.4678L0.21967 9.40717ZM10.6875 0.75C10.6875 0.335786 10.3517 2.97145e-09 9.9375 1.50485e-07L3.1875 -2.70983e-07C2.77329 -2.70983e-07 2.4375 0.335786 2.4375 0.75C2.4375 1.16421 2.77329 1.5 3.1875 1.5H9.1875V7.5C9.1875 7.91421 9.52329 8.25 9.9375 8.25C10.3517 8.25 10.6875 7.91421 10.6875 7.5L10.6875 0.75ZM0.75 9.9375L1.28033 10.4678L10.4678 1.28033L9.9375 0.75L9.40717 0.21967L0.21967 9.40717L0.75 9.9375Z" fill="currentColor" />
                  </svg>
                </i>
              </a>
            </div>
          </div>

        </div>
      </div>
    </div>
    <!-- portfolio details 2 area end -->

    <!-- overview start -->
    <div class="tp-pd-2-overview-ptb pb-25">
      <div class="container">
        <div class="tp-about-border pt-70">
          <div class="row">
            <div class="col-lg-6">
              <div class="tp-pd-2-overview-heading tp_fade_anim" data-delay=".3">
                <h3 class="tp-pd-2-overview-title reveal-text">{d.overviewTitle}</h3>
              </div>
            </div>

            <div class="col-xl-5 col-lg-6">
              <div class="tp-pd-2-overview-wrap mr-100">
                {d.overviewParagraphs.map((p) => <p>{p}</p>)}

                {d.overviewBullets?.length ? (
                  <ul>
                    {d.overviewBullets.map((b) => <li>{b}</li>)}
                  </ul>
                ) : null}
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
    <!-- overview end -->

    <!-- gallery start -->
    <div class="tp-pd-2-area pb-110 mt-150">
      <div class="container-fluid p-0">
        <div class="row gx-20">
          <div class="col-lg-12">
            <div class=" mb-20 scale-up-img">
              <img data-speed=".8" class="img-cover " src={d.galleryMain} alt={d.title} />
            </div>
          </div>

          <!-- {(d.galleryGrid || []).map((img, idx) => (
            <div class={idx === 1 ? "col-lg-6 col-md-6" : "col-lg-6 col-md-6"}>
              <div class="tp-pd-2-thumb-item scale-up-img mb-20">
                <img data-speed=".8" class="img-cover scale-up" src={img} alt={`${d.title} ${idx + 1}`} />
              </div>
            </div>
          ))} -->
        </div>
      </div>
    </div>
    <!-- gallery end -->

    <!-- steps start -->
    <div class="tp-pd-2-step-ptb pb-95 mt-50">
      <div class="container">
        <div class="row">
          <div class="col-lg-12">
            <div class="tp-pd-2-step-heading pb-60 tp_fade_anim" data-delay=".3">
              <h3 class="tp-pd-2-step-title reveal-text">{d.stepsTitle}</h3>
            </div>
          </div>
        </div>

        <div class="row">
          {d.steps.map((s) => (
            <div class="col-lg-3 col-md-6">
              <div class="tp-pd-2-step-item mb-30">
                <h4 class="tp-pd-2-step-item-title">{s.number}. {s.title}</h4>
                <span>{s.text}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
    <!-- steps end -->

    <!-- related start -->
    <div class="tp-portfolio-area pb-110">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <div class="mb-25">
              <h2 class="tp-portfoliom-m-title reveal-text">Related Project</h2>
            </div>
          </div>

          {related.map((r) => (
            <div class="col-lg-6">
              <div class="mg-portfolio-item anim-zoomin-wrap mb-40">
                <div class="mg-portfolio-thumb anim-zoomin not-hide-cursor" data-cursor="View<br>Demo">
                  <a class="cursor-hide" href={`/portfolio/${r.slug}`}>
                    <img class="w-100" src={r.data.cardImage} alt={r.data.title} />
                  </a>
                </div>

                <div class="mg-portfolio-content cs-portfolio-content d-flex align-items-center flex-wrap justify-content-between">
                  <h3 class="cs-portfolio-title tp-title-anim fix mr-20 tp-ff-sequel-semi-bold">
                    <a href={`/portfolio/${r.slug}`} class="tp-title-text">{r.data.title}</a>
                  </h3>

                  <div class="cs-portfolio-tag">
                    <ul>
                      {r.data.tags.map((t) => (
                        <li><a href="#">{t}</a></li>
                      ))}
                    </ul>
                  </div>
                </div>

              </div>
            </div>
          ))}

        </div>
      </div>
    </div>
    <!-- related end -->

  </main>
</BaseLayout>
