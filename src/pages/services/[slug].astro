---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const items = await getCollection("services");
  return items.map((item) => ({
    params: { slug: item.slug },
    props: { service: item },
  }));
}

const { service } = Astro.props;
const d = service.data;
const slug = service.slug;
const faqOneGroup = `service-faq-one-${slug}`;
const faqTwoGroup = `service-faq-two-${slug}`;
---

<BaseLayout headerVariant="promo" title={`100XLIFT - ${d.title}`}>
  <div id="smooth-wrapper">
    <div id="smooth-content">
      <main>
        <!-- tp-service-details-area-start -->
        <div class="tp-service-details-banner-area about-us-spacing pb-80">
          <div class="container">
            <div class="row">
              <div class="col-xl-2 col-lg-4">
                <div class="tp-service-details-hero-subtitle mb-20 tp_fade_anim" data-delay=".3">
                  <span class="text-uppercase fw-500">{d.heroSubtitle}
                    <svg width="64" height="8" viewBox="0 0 64 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <rect y="3.5" width="62.5039" height="1" fill="currentColor" />
                      <path d="M59.5273 7.46366L62.9998 3.98183L59.5273 0.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                </div>
              </div>
              <div class="col-xl-6 col-lg-8">
                <div class="tp-service-details-hero-title ml-115 tp_fade_anim" data-delay=".5">
                  <h2 class="tp-ff-sequel-bold-head" set:html={d.heroTitle}></h2>
                </div>
              </div>
              <div class="col-xl-4 col-lg-6">
                <div class="ca-hero-service tp-service-details-hero-link ml-90 mt-90 tp_fade_anim" data-delay=".7">
                  <ul>
                    {d.heroLinks.map((item) => (
                      <li>
                        <a href="#"><span class="explore-text" data-text={`+ ${item}`}>+ {item}</span></a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- tp-service-details-area-end -->

        <!-- tp-banner-area-start -->
        <div class="tp-banner-thumb fix w-100 scale-up-img">
          <img data-speed="0.4" class="img-cover scale-up" src={d.bannerTop} alt={d.title} />
        </div>
        <!-- tp-banner-area-end -->

        <!-- tp-process-area-start -->
        <div class="tp-process-area pt-85 pb-130 p-relative z-index-1">
          <div class="container">
            <div class="row">
              <div class="col-12">
                <div class="text-center mb-40">
                  <h2 class="tp-section-title reveal-text fs-72" set:html={d.processTitle}></h2>
                </div>
              </div>
              <div class="col-xxl-10 offset-xxl-1 col-12">
                <div class="tp-process-border d-none d-lg-block">
                  <svg viewBox="0 0 1320 6" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M5 2.5L0 0.113249V5.88675L5 3.5V2.5ZM1315 3.5L1320 5.88675V0.113249L1315 2.5V3.5ZM4.5 3.5H1315.5V2.5H4.5V3.5Z" fill="currentColor" fill-opacity="0.1" />
                  </svg>
                </div>
                <div class="row">
                  {d.processSteps.map((step, idx) => (
                    <div class="col-lg-3 col-md-6 col-sm-6">
                      <div class="tp-process-item text-center mb-30 tp_fade_anim" data-delay={(0.3 + idx * 0.1).toFixed(1)} data-fade-from="left">
                        <span class="tp-process-count d-inline-block text-center fw-600 mb-45">{step.number}</span>
                        <h3 class="tp-process-title mb-20" set:html={step.title}></h3>
                        <p class="tp-process-dec" set:html={step.text}></p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
              <div class="col-lg-12">
                <div class="tp-process-bottom text-center mt-40 tp_fade_anim" data-delay=".5" data-fade-from="bottom" data-ease="bounce">
                  <p class="tp-process-bottom-para">{d.processCtaText}
                    <a href={d.processCtaUrl} class="ml-20 d-inline-block lh-0 tp-btn-switch-animation fw-700">
                      <span class="d-flex align-items-center justify-content-center">
                        <span class="btn-text">{d.processCtaLabel}</span>
                        <span class="btn-icon">
                          <svg width="25" height="10" viewBox="0 0 25 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M18.675 9.91054L24.72 5.63362C24.806 5.56483 24.8766 5.47086 24.9255 5.36023C24.9744 5.2496 25 5.12579 25 5C25 4.87421 24.9744 4.7504 24.9255 4.63977C24.8766 4.52914 24.806 4.43518 24.72 4.36638L18.675 0.0894619C18.5572 0.0111909 18.4215 -0.0168364 18.2892 0.00979851C18.157 0.0364334 18.0358 0.116215 17.9446 0.236567C17.8535 0.356918 17.7977 0.510993 17.7859 0.674501C17.7742 0.838009 17.8072 1.00165 17.8798 1.13963L19.633 4.26665L0.598757 4.26665C0.439957 4.26665 0.287661 4.34391 0.175371 4.48144C0.0630817 4.61897 0 4.8055 0 5C0 5.1945 0.0630817 5.38103 0.175371 5.51856C0.287661 5.65609 0.439957 5.73335 0.598757 5.73335L19.633 5.73335L17.8798 8.86038C17.8072 8.99835 17.7742 9.16199 17.7859 9.3255C17.7977 9.48901 17.8535 9.64308 17.9446 9.76343C18.0358 9.88378 18.157 9.96357 18.2892 9.9902C18.4215 10.0168 18.5572 9.98881 18.675 9.91054Z" fill="currentColor" />
                          </svg>
                        </span>
                        <span class="btn-icon">
                          <svg width="25" height="10" viewBox="0 0 25 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M18.675 9.91054L24.72 5.63362C24.806 5.56483 24.8766 5.47086 24.9255 5.36023C24.9744 5.2496 25 5.12579 25 5C25 4.87421 24.9744 4.7504 24.9255 4.63977C24.8766 4.52914 24.806 4.43518 24.72 4.36638L18.675 0.0894619C18.5572 0.0111909 18.4215 -0.0168364 18.2892 0.00979851C18.157 0.0364334 18.0358 0.116215 17.9446 0.236567C17.8535 0.356918 17.7977 0.510993 17.7859 0.674501C17.7742 0.838009 17.8072 1.00165 17.8798 1.13963L19.633 4.26665L0.598757 4.26665C0.439957 4.26665 0.287661 4.34391 0.175371 4.48144C0.0630817 4.61897 0 4.8055 0 5C0 5.1945 0.0630817 5.38103 0.175371 5.51856C0.287661 5.65609 0.439957 5.73335 0.598757 5.73335L19.633 5.73335L17.8798 8.86038C17.8072 8.99835 17.7742 9.16199 17.7859 9.3255C17.7977 9.48901 17.8535 9.64308 17.9446 9.76343C18.0358 9.88378 18.157 9.96357 18.2892 9.9902C18.4215 10.0168 18.5572 9.98881 18.675 9.91054Z" fill="currentColor" />
                          </svg>
                        </span>
                      </span>
                    </a>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- tp-process-area-end -->

        <!-- tp-service-overview-area-start -->
        <div class="tp-service-overview-area pb-120">
          <div class="container">
            <div class="row">
              <div class="col-lg-12">
                <div class="tp-service-overview-top mb-50">
                  <h2 class="tp-section-title reveal-text fs-72 mb-30">{d.overviewTitle}</h2>
                  <div class="tp-process-border tp-service-overview-border d-none d-lg-block">
                    <svg viewBox="0 0 1320 6" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M5 2.5L0 0.113249V5.88675L5 3.5V2.5ZM1315 3.5L1320 5.88675V0.113249L1315 2.5V3.5ZM4.5 3.5H1315.5V2.5H4.5V3.5Z" fill="currentColor" fill-opacity="0.1" />
                    </svg>
                  </div>
                </div>
              </div>
              <div class="col-lg-5">
                <div class="tp-service-details-content mb-40 mr-115">
                  <p class="tp-service-details-dec mb-45">{d.overviewDescription}</p>
                  <h5 class="tp-service-details-title mb-30">{d.overviewApproachTitle}</h5>
                  <ul>
                    {d.overviewApproachBullets.map((item) => (
                      <li>
                        <i class="fa-regular fa-circle-check"></i>
                        <p>{item}</p>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
              <div class="col-lg-7">
                <div class="tp-service-thumb mb-30">
                  <img class="w-100" src={d.overviewImage} alt={d.title} />
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- tp-service-overview-area-end -->

        <!-- tp-faq-area-start -->
        <div class="tp-faq-area pb-130">
          <div class="container">
            <div class="row">
              <div class="col-xxl-5 col-xl-3">
                <div class="tp-faq-subtitle mb-30">
                  <span class="text-uppercase fw-500">{d.faqOneSubtitle}</span>
                </div>
              </div>
              <div class="col-xxl-7 col-xl-9">
                <div class="tp-faq tp-service-details-faq-one tp-service-details-faq mb-30">
                  <h2 class="tp-section-title reveal-text fs-72 mb-30" set:html={d.faqOneTitle}></h2>
                  <p class="mb-40">{d.faqOneSupport}</p>
                  <div class="accordion" id={faqOneGroup}>
                    {d.faqOneItems.map((item, idx) => {
                      const isOpen = idx === 0;
                      const itemId = `${faqOneGroup}-${idx}`;
                      return (
                        <div class="tp-faq-item tp_fade_anim" data-delay=".3">
                          <h2 class="accordion-header">
                            <button
                              class={`tp-faq-button${isOpen ? "" : " collapsed"}`}
                              type="button"
                              data-bs-toggle="collapse"
                              data-bs-target={`#${itemId}`}
                              aria-expanded={isOpen ? "true" : "false"}
                              aria-controls={itemId}
                            >
                              {item.number}. {item.title}
                            </button>
                          </h2>
                          <div id={itemId} class={`tp-faq-collapse collapse${isOpen ? " show" : ""}`} data-bs-parent={`#${faqOneGroup}`}>
                            <div class="tp-faq-body">
                              <p set:html={item.bodyHtml}></p>
                            </div>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- tp-faq-area-end -->

        <!-- tp-banner-area-start -->
        <div class="tp-banner-thumb fix w-100 scale-up-img">
          <img data-speed="0.4" class="img-cover scale-up" src={d.bannerBottom} alt={d.title} />
        </div>
        <!-- tp-banner-area-end -->

        <!-- tp-faq-area-start -->
        <div class="tp-faq-area pb-130 pt-145">
          <div class="container">
            <div class="row">
              <div class="col-xxl-5 col-xl-3">
                <div class="tp-faq-subtitle mb-30">
                  <span class="text-uppercase fw-500">{d.faqTwoSubtitle}</span>
                </div>
              </div>
              <div class="col-xxl-7 col-xl-9">
                <div class="tp-faq tp-service-details-faq-two tp-service-details-faq mb-30">
                  <h2 class="tp-section-title reveal-text fs-72 mb-40" set:html={d.faqTwoTitle}></h2>
                  <div class="accordion" id={faqTwoGroup}>
                    {d.faqTwoItems.map((item, idx) => {
                      const isOpen = idx === 0;
                      const itemId = `${faqTwoGroup}-${idx}`;
                      return (
                        <div class="tp-faq-item tp_fade_anim" data-delay=".3">
                          <h2 class="accordion-header">
                            <button
                              class={`tp-faq-button${isOpen ? "" : " collapsed"}`}
                              type="button"
                              data-bs-toggle="collapse"
                              data-bs-target={`#${itemId}`}
                              aria-expanded={isOpen ? "true" : "false"}
                              aria-controls={itemId}
                            >
                              <span>{item.number}</span>{item.question}
                            </button>
                          </h2>
                          <div id={itemId} class={`tp-faq-collapse collapse${isOpen ? " show" : ""}`} data-bs-parent={`#${faqTwoGroup}`}>
                            <div class="tp-faq-body">
                              <p set:html={item.answerHtml}></p>
                            </div>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- tp-faq-area-end -->

        <!-- tp-cta-area-start -->
        <div class="tp-cta-area pt-120 pb-130">
          <div class="container">
            <div class="row justify-content-center text-center">
              <div class="col-xl-8">
                <span class="tp-section-subtitle text-uppercase d-inline-block mb-25">{d.finalCtaSubtitle}</span>
                <h2 class="tp-section-title reveal-text fs-72 mb-40">{d.finalCtaTitle}</h2>
                <a class="tp-btn tp-btn-border" href={d.finalCtaButtonUrl}>
                  <span>
                    <span class="text-1">{d.finalCtaButtonLabel}</span>
                    <span class="text-2">{d.finalCtaButtonLabel}</span>
                  </span>
                  <i>
                    <svg width="11" height="11" viewBox="0 0 11 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M0.21967 9.40717C-0.0732232 9.70006 -0.0732232 10.1749 0.21967 10.4678C0.512563 10.7607 0.987437 10.7607 1.28033 10.4678L0.21967 9.40717ZM10.6875 0.75C10.6875 0.335786 10.3517 2.97145e-09 9.9375 1.50485e-07L3.1875 -2.70983e-07C2.77329 -2.70983e-07 2.4375 0.335786 2.4375 0.75C2.4375 1.16421 2.77329 1.5 3.1875 1.5H9.1875V7.5C9.1875 7.91421 9.52329 8.25 9.9375 8.25C10.3517 8.25 10.6875 7.91421 10.6875 7.5L10.6875 0.75ZM0.75 9.9375L1.28033 10.4678L10.4678 1.28033L9.9375 0.75L9.40717 0.21967L0.21967 9.40717L0.75 9.9375Z" fill="currentColor" />
                    </svg>
                    <svg width="11" height="11" viewBox="0 0 11 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M0.21967 9.40717C-0.0732232 9.70006 -0.0732232 10.1749 0.21967 10.4678C0.512563 10.7607 0.987437 10.7607 1.28033 10.4678L0.21967 9.40717ZM10.6875 0.75C10.6875 0.335786 10.3517 2.97145e-09 9.9375 1.50485e-07L3.1875 -2.70983e-07C2.77329 -2.70983e-07 2.4375 0.335786 2.4375 0.75C2.4375 1.16421 2.77329 1.5 3.1875 1.5H9.1875V7.5C9.1875 7.91421 9.52329 8.25 9.9375 8.25C10.3517 8.25 10.6875 7.91421 10.6875 7.5L10.6875 0.75ZM0.75 9.9375L1.28033 10.4678L10.4678 1.28033L9.9375 0.75L9.40717 0.21967L0.21967 9.40717L0.75 9.9375Z" fill="currentColor" />
                    </svg>
                  </i>
                </a>
              </div>
            </div>
          </div>
        </div>
        <!-- tp-cta-area-end -->
      </main>
    </div>
  </div>
</BaseLayout>
