---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const services = await getCollection("services");
const sorted = services
  .slice()
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<BaseLayout headerVariant="promo" title="100XLIFT - Services">
  <main>
    <!-- services-area-start -->
    <div id="services" class="about-me-resume-area pt-145 pb-160">
      <div class="container">
        <div class="row">
          <div class="col-lg-2">
            <div class="tp-about-subtitle-wrap mb-20 mt-15 tp_fade_anim" data-delay=".3">
              <span class="tp-section-subtitle text-uppercase">Specialties</span>
            </div>
          </div>
          <div class="col-lg-10">
            <div class="about-me-resume-content mb-20 tp_fade_anim" data-delay=".5">
              <h2 class="tp-section-title reveal-text">
                At <span class="middle-text-change-color">100XLIFT</span>, we don't just<br />
                build website or campaigns<br />
                we craft purpose.
              </h2>
            </div>
          </div>
          <div class="col-12">
            <div class="inner-service-2-wrap about-me-resume-wrap mt-50">
              {sorted.map((service) => (
                <div class="about-me-resume-item tp_fade_anim" data-delay=".3">
                  <div class="row">
                    <div class="col-lg-2">
                      <div class="about-me-resume-date mb-30">
                        <span>{service.data.listDate}</span>
                      </div>
                    </div>
                    <div class="col-lg-5">
                      <div class="about-me-resume-info ml-40 mb-30">
                        <h3 class="about-me-resume-title tp-ff-sequel-semi-bold">
                          <a href={`/services/${service.slug}`} set:html={service.data.listTitleHtml}></a>
                        </h3>
                      </div>
                    </div>
                    <div class="col-lg-5">
                      <div class="about-me-resume-dec ml-50 mb-30">
                        <p>{service.data.listSummary}</p>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
