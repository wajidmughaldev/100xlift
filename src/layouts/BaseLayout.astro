// Description guard
const safeDescription = (description || "").trim();

const resolvedOgTitle = (ogTitle || safeTitle).trim();
const resolvedOgDescription = (ogDescription || safeDescription).trim();
const resolvedOgUrl = ogUrl || resolvedCanonical;
const resolvedTwitterTitle = (twitterTitle || resolvedOgTitle).trim();
const resolvedTwitterDescription = (twitterDescription || resolvedOgDescription).trim();

